##############################################################################
# ── HTML OUTPUT ─────────────────────────────────────────────────────────────
##############################################################################
def render_table(df: pd.DataFrame, hl, title: str, top_patterns):
    """Return HTML chunk with highlight overlay + mini scoreboard."""
    h  = [f"<h2>{title}</h2>"]
    h += ["<table style='border-collapse:collapse;'>"]
    # header
    h += ["<tr><th>Set</th><th>Draw</th><th>Row</th>" +
          ''.join(f"<th>{c}</th>" for c in COLS) + "</tr>"]
    for i,row in df.iterrows():
        h.append("<tr>")
        h.append(f"<td>{row['Set']}</td><td>{row['Draw']}</td><td>{row['RowType']}</td>")
        for col in COLS:
            raw = str(row[col])
            if not raw.strip() or raw.strip().lower()=='nan':
                h.append("<td></td>"); continue
            mask = hl.get((i,col), [False]*len(raw))
            cell_out = ""
            for j,ch in enumerate(raw):
                if mask[j] and (j==0 or not mask[j-1]):
                    cell_out += "<span style='background:#ffff6b;'>"
                cell_out += ch
                if mask[j] and (j==len(raw)-1 or not mask[j+1]):
                    cell_out += "</span>"
            h.append(f"<td>{cell_out}</td>")
        h.append("</tr>")
    h.append("</table>")

    # mini pattern list (top 30)
    h.append("<h4>Top patterns (score ↓)</h4>")
    h.append("<table style='border-collapse:collapse;'><tr>" +
             "<th>Set</th><th>Draw</th><th>Col</th><th>Pattern</th>" +
             "<th>Score</th><th>Rows</th><th>Span</th><th>V-Trac</th></tr>")
    for r in top_patterns[:30]:
        h.append(f"<tr><td>{r['Set']}</td><td>{r['Draw']}</td><td>{r['Column']}</td>"
                 f"<td>{r['Pattern']}</td><td>{r['score']}</td>"
                 f"<td>{r['coverage']}</td><td>{r['span']}</td><td>{r['vtrac']}</td></tr>")
    h.append("</table><hr/>")
    return '\n'.join(h)

##############################################################################
# ── CLI ENTRY ───────────────────────────────────────────────────────────────
##############################################################################
def run_cli():
    ap = argparse.ArgumentParser(description="Stable-Pattern Extractor FULL")
    ap.add_argument("--files", nargs="+", required=True, help="One or more combined-table CSVs.")
    ap.add_argument("--html", default="stable_patterns_report.html")
    ap.add_argument("--csv",  default="stable_patterns_scores.csv")
    args = ap.parse_args()

    html_chunks = []
    all_scores  = []

    for path in args.files:
        if not os.path.exists(path):
            print(f"[!] File not found → {path}"); continue
        # guess section from filename else use file basename
        fname = os.path.basename(path)
        m = re.search(r'_(Midday|Evening|Combined)_', fname, re.I)
        section = m.group(1) if m else os.path.splitext(fname)[0]

        df = pd.read_csv(path, dtype=str)
        hl, scores = analyse_section(df, section)
        html_chunks.append(render_table(df, hl, section, scores))
        all_scores.extend(scores)
        print(f"✓ {section}: {len(scores)} patterns")

    if not html_chunks:
        print("No valid CSVs processed."); sys.exit(0)

    # write HTML
    full_html = f"""<!DOCTYPE html><html><head>
    <meta charset='utf-8'><title>Stable Patterns Report</title>
    <style>body{{font-family:Arial,Helvetica,sans-serif;font-size:14px}}</style></head><body>
    <h1>Stable Pattern Extractor – Report</h1>
    <p>Generated: {datetime.now():%Y-%m-%d %H:%M:%S}</p>
    {''.join(html_chunks)}
    </body></html>"""
    with open(args.html,'w',encoding='utf-8') as f:
        f.write(full_html)
    print(f"HTML → {args.html}")

    # write CSV
    pd.DataFrame(all_scores).to_csv(args.csv,index=False)
    print(f"CSV  → {args.csv}")

