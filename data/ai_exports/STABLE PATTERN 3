                st.error(f"File not found: {p}"); continue
            m = re.search(r'_(Midday|Evening|Combined)_', os.path.basename(p), re.I)
            section = m.group(1) if m else os.path.splitext(os.path.basename(p))[0]
            df = pd.read_csv(p,dtype=str)
            hl,scores = analyse_section(df,section)
            html_chunks.append(render_table(df,hl,section,scores))
            all_scores.extend(scores)
        if not html_chunks:
            st.stop()

        # show top-level DataFrame
        st.subheader("Top 100 patterns")
        st.dataframe(pd.DataFrame(all_scores).sort_values('score',ascending=False).head(100))

        # write outputs
        with open(out_html,'w',encoding='utf-8') as f:
            f.write("<html><head><meta charset='utf-8'></head><body>"+''.join(html_chunks)+"</body></html>")
        pd.DataFrame(all_scores).to_csv(out_csv,index=False)
        st.success(f"Saved →  {out_html}, {out_csv}")
        st.components.v1.html(''.join(html_chunks), height=800, scrolling=True)

