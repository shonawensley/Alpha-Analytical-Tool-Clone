5. Tiny Aggregator stub (creates supervised rows)
Create scripts/core/aggregate_predictions_vs_winners.py:
python
CopyEdit
import json, pathlib, pandas as pd, sys
date = sys.argv[1]  # e.g. 2025-06-06
pred_dir = pathlib.Path("data/outputs/predictions")
win_dir  = pathlib.Path("data/outputs/winners_json")
rows = []
for p in pred_dir.glob(f"*_{date}_predictions.json"):
    state = p.stem.split("_")[0]
    w     = win_dir / f"{state}_{date}_winners.json"
    if not w.exists(): continue
    preds = json.load(open(p))
    wins  = json.load(open(w))
    win_nums = {wins["winners"]["midday"], wins["winners"]["evening"]}
    for rec in preds["predictions"]:
        rows.append({
            "state": state,
            "rank":  rec["rank"],
            "index": rec["index"],
            "score": rec["score"],
            "hit":   any(pat in win_nums for pat in rec["patterns"])
        })
pd.DataFrame(rows).to_csv(f"data/outputs/training_examples_{date}.csv", index=False)
print("wrote training_examples")
