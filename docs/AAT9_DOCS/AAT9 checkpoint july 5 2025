import json, pathlib, fire
from utils import path_handler as ph

def main(state: str, date: str):
    date = str(date)
    w_mid = ph.get_winners_dir(state) / f"{date}_midday.json"
    w_eve = ph.get_winners_dir(state) / f"{date}_evening.json"
