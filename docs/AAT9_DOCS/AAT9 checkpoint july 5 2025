    if not (w_mid.exists() and w_eve.exists() and preds.exists()):
        raise FileNotFoundError("Missing winner or prediction file.")

    bundle = {
        "state": state,
        "date":  date,
        "winner_mid": json.load(w_mid.open())["draw"],
        "winner_eve": json.load(w_eve.open())["draw"],
        "vtrac_preds": json.load(preds.open())["top_indices"],
        # attach future stable pattern & digit flags here …
    }
    out = pathlib.Path(f"data/outputs/bundles/{state}")
    out.mkdir(parents=True, exist_ok=True)
    json.dump(bundle, (out / f"{date}_bundle.json").open("w"))
    print("Bundle written →", out)

if __name__ == "__main__":
    fire.Fire(main)
