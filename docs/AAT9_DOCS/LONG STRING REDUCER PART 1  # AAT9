SECTION_NAMES = ["Midday", "Evening", "Combined"]


def load_section_csv(state_dir: Path, section: str) -> pd.DataFrame:
    """Load the Combined Table CSV for a section (Midday / Evening / Combined)."""
    csv_path = state_dir / f"{section}_combined.csv"
    if not csv_path.exists():
        raise FileNotFoundError(csv_path)
    return pd.read_csv(csv_path, dtype=str).fillna("")


def extract_r2_strings_area1(df: pd.DataFrame, section: str) -> Dict[str, str]:
    """Return the nine Area‑1 R2 strings for this section.

    Keys follow pattern  <section>|<set>|Draw1|col<7/6/5>"""
    out: Dict[str, str] = {}
    # filter just R2 rows in Set3/Set2/Set1 + Draw1
    mask = (df["RowType"] == "R2") & (df["Draw"] == "Draw1") & (df["Set"].isin(["Set3", "Set2", "Set1"]))
    sub = df[mask].copy()
    for _, row in sub.iterrows():
        set_name = row["Set"]
        # combined table stores columns 7→1 left‑to‑right in the CSV
        for col_num, col_label in zip([7, 6, 5], ["7", "6", "5"]):
            r2_string = str(row[col_label]).strip()
            loc_id = f"{section}|{set_name}|Draw1|col{col_num}"
            if r2_string:
                out[loc_id] = r2_string
    return out


def extract_r2_strings_area2(df: pd.DataFrame, section: str) -> Dict[str, str]:
    """Return the six Area‑2 R2 strings (Set1‑Draw4‑col3 and Set1‑Draw6‑col1)."""
    out: Dict[str, str] = {}
    mask = (df["RowType"] == "R2") & (df["Set"] == "Set1") & (df["Draw"].isin(["Draw4", "Draw6"]))
    sub = df[mask].copy()
    for _, row in sub.iterrows():
        draw = row["Draw"]
        # map wanted column numbers to csv columns
        target_cols = {"Draw4": 3, "Draw6": 1}
        col_num = target_cols[draw]
        csv_col = str(col_num)  # column label in the CSV ("3" or "1")
        r2_string = str(row[csv_col]).strip()
        if r2_string:
            loc_id = f"{section}|Set1|{draw}|col{col_num}"
            out[loc_id] = r2_string
    return out

