def _parse_digits(three_digit_str: str) -> List[str]:
    return list(three_digit_str.strip()) if three_digit_str else []


def assemble_draw_sequence(df: pd.DataFrame, section: str, start_set: str, start_draw: str) -> List[List[str]]:
    """Return a *chronological* list of draw digits that occurred *after*
    (start_set,start_draw) in the given section.  This is used for OWN mode.

    We walk Set1 downward first (DrawN+1 .. Draw7), then newer sets if any.
    """
    sequence: List[List[str]] = []

    # Helper to compare set/draw order quickly
    set_order = {"Set3": 3, "Set2": 2, "Set1": 1}

    for _, row in df[df["RowType"] == "DRAW_DATA"].iterrows():
        s = row["Set"]
        d = row["Draw"]
        # Only consider draws *after* the starting point
        if set_order[s] > set_order[start_set]:  # newer set than starting set (Set1 newer than Set2 etc.)
            after = True
        elif set_order[s] == set_order[start_set]:
            # same set – keep draws with higher draw index (Draw2 after Draw1, etc.)
            after = d > start_draw
        else:
            after = False
        if not after:
            continue
        # add all valid 3‑digit entries in the row (they’re stored in columns 7..1)
        for col_label in ["7","6","5","4","3","2","1"]:
            digit_triplet = str(row[col_label]).strip()
            if digit_triplet:
                sequence.append(_parse_digits(digit_triplet))
    return sequence


