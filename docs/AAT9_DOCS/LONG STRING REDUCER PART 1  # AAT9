# -----------------------------------------------------------------
#  SIMPLE draw-sequence helper (good enough for first HTML run)
# -----------------------------------------------------------------
def get_draw_lists_for_section(big_data, section):
    """
    Returns a dict:
      {
         "own":       [ [d,d,d], [d,d,d], ... ]   # newest → oldest
         "combined":  same list but interleaved with the opposite section
      }
    """
    def _triplets(sec):
        draws = []
        sec_data = big_data["sections"][sec]["sets"]["Set1"]["draws"]
        for dname in ["Draw1","Draw2","Draw3","Draw4","Draw5","Draw6","Draw7"]:
            if dname not in sec_data:
                continue
            row = sec_data[dname]
            for col in ["1","2","3","4","5","6","7"]:   # col1 newest
                trip = str(row.get(col, "")).strip()
                if trip:
                    draws.append(list(trip))
        return draws

    own = _triplets(section)

    if section == "Combined":        # combined’s own = combined
        combined = own
    else:
        opp_sec = "Evening" if section == "Midday" else "Midday"
        opp = _triplets(opp_sec)
        # simple newest-first interleave
        combined = []
        for i in range(max(len(own), len(opp))):
            if i < len(own): combined.append(own[i])
            if i < len(opp): combined.append(opp[i])

    return {"own": own, "combined": combined}
