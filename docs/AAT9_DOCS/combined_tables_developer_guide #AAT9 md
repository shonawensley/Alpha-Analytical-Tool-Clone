# Get all strings across a row
def get_row_strings(df, set_name, draw_name, row_type):
    row = df[(df['Set'] == set_name) & 
             (df['Draw'] == draw_name) & 
             (df['RowType'] == row_type)]
    
    if row.empty:
        return None
    
    return {
        '7': row.iloc[0].get('7', ''),
        '6': row.iloc[0].get('6', ''),
        '5': row.iloc[0].get('5', ''),
        '4': row.iloc[0].get('4', ''),
        '3': row.iloc[0].get('3', ''),
        '2': row.iloc[0].get('2', ''),
        '1': row.iloc[0].get('1', '')
    }
```

### Finding Patterns

```python
def find_patterns_in_table(df, patterns):
    """Find occurrences of patterns in a combined table"""
    results = {pattern: [] for pattern in patterns}
    
    # Check each cell for patterns
    for _, row in df.iterrows():
        for col in ['7', '6', '5', '4', '3', '2', '1']:
            if col in df.columns and not pd.isna(row[col]):
                cell_value = str(row[col])
                for pattern in patterns:
                    if pattern in cell_value:
                        # Record the location
                        results[pattern].append({
                            'Set': row['Set'],
                            'Draw': row['Draw'],
                            'RowType': row['RowType'],
                            'Column': col,
                            'Position': cell_value.find(pattern)
                        })
    
    return results
```

## Creating New Analytical Tools

### Core Principles

1. **Non-destructive**: Tools should not modify the original tables
2. **Standalone**: Keep analysis logic separate from table generation
3. **Input/Output clarity**: Define clear inputs and outputs
4. **Error handling**: Gracefully handle missing or malformed data
5. **Documentation**: Document what your tool does and how it works

### Integration Points

There are three main ways to integrate with the existing system:

1. **Post-processing**: Build tools that take the combined tables as input
2. **UI integration**: Add new tabs or sections to the Streamlit interface
3. **Data augmentation**: Generate additional data based on the tables

### Integration Example: Pattern Frequency Analyzer

```python
# pattern_frequency_analyzer.py

import pandas as pd
from collections import Counter

def analyze_pattern_frequency(state_data, patterns, timeframe="Midday"):
    """
    Analyze frequency of patterns across different tables
    
    Args:
        state_data (dict): Dictionary containing the state's table DataFrames
        patterns (list): List of patterns to analyze
        timeframe (str): Which timeframe to analyze ("Midday", "Evening", "Combined")
        
    Returns:
        dict: Frequency analysis results
    """
    # Get the right table
    table_key = f"{timeframe}_combined"
    if table_key not in state_data:
        return {"error": f"No {table_key} table found"}
    
    table = state_data[table_key]
    
    # Analyze pattern frequencies
    results = {}
    for pattern in patterns:
        result = {
            "total_occurrences": 0,
            "by_set": Counter(),
            "by_draw": Counter(),
            "by_row_type": Counter(),
            "by_column": Counter()
        }
        
        # Check each cell
        for _, row in table.iterrows():
            for col in ['7', '6', '5', '4', '3', '2', '1']:
                if col in table.columns and not pd.isna(row[col]):
                    cell_value = str(row[col])
                    count = cell_value.count(pattern)
                    
                    if count > 0:
                        result["total_occurrences"] += count
                        result["by_set"][row["Set"]] += count
                        result["by_draw"][row["Draw"]] += count
                        result["by_row_type"][row["RowType"]] += count
                        result["by_column"][col] += count
        
        results[pattern] = result
    
    return results
```

