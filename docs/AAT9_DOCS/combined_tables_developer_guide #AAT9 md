                    result[key] = df
                except Exception as e:
                    print(f"Error loading {filename}: {e}")
    
    return result

def analyze_data(state_data, table_key, parameters):
    """
    Main analysis function - replace with your specific analysis
    
    Args:
        state_data (dict): Dictionary containing the state's table DataFrames
        table_key (str): Key for the table to analyze (e.g., "Midday_combined")
        parameters (dict): Parameters for the analysis
        
    Returns:
        dict: Analysis results
    """
